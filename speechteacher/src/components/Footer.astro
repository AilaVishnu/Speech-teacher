---
const year = new Date().getFullYear();
const columns = [
  {
    title: "Product",
    links: [
      { href: "/features", label: "Features" },
      { href: "/how-it-works", label: "How it works" },
      { href: "/pricing", label: "Pricing" },
      { href: "/practice", label: "Practice now" },
    ],
  },
  {
    title: "Resources",
    links: [
      { href: "/resources", label: "All articles" },
      { href: "/resources/overcome-fear-of-public-speaking", label: "Overcome the fear" },
      { href: "/resources/reduce-filler-words", label: "Cut filler words" },
    ],
  },
  {
    title: "Company",
    links: [
      { href: "/about", label: "About" },
      { href: "/pricing", label: "Pricing" },
    ],
  },
];
---

<footer class="border-t border-hairline bg-canvas">
  <div class="container-page py-16">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-ink">
          <span class="mesh-gradient inline-block h-6 w-6 rounded-md" style="filter:none;" aria-hidden="true"></span>
          SpeechTeacher
        </a>
        <p class="mt-3 max-w-xs text-sm text-body">
          Practice public speaking privately. Instant feedback on pace and filler
          words — transcribed on your device, never uploaded.
        </p>
      </div>

      {columns.map((col) => (
        <div>
          <h2 class="font-mono text-xs uppercase tracking-wide text-mute">{col.title}</h2>
          <ul class="mt-4 space-y-3">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-body transition-colors hover:text-ink">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-hairline pt-6 text-sm text-mute sm:flex-row sm:items-center">
      <p>© {year} SpeechTeacher · speechteacher.in</p>
      <p>Built privacy-first. Your voice stays on your device.</p>
    </div>
  </div>
</footer>
