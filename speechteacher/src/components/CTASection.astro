---
import Button from "./Button.astro";
export interface Props {
  heading?: string;
  sub?: string;
}
const {
  heading = "Your next rep starts now.",
  sub = "No sign-up. No upload. Just open it and speak.",
} = Astro.props;
---

<section class="container-page py-24">
  <div class="relative overflow-hidden rounded-xl bg-primary px-8 py-16 text-center sm:px-16">
    <div class="mesh-gradient absolute inset-0 opacity-30" aria-hidden="true"></div>
    <div class="relative">
      <h2 class="mx-auto max-w-2xl text-3xl font-semibold tracking-tight text-on-primary sm:text-4xl">
        {heading}
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-white/70">{sub}</p>
      <div class="mt-8 flex justify-center">
        <Button href="/practice" variant="secondary">Start practicing free</Button>
      </div>
    </div>
  </div>
</section>
