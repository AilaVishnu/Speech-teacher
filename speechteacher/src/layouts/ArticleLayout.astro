---
import Layout from "./Layout.astro";
import CTASection from "../components/CTASection.astro";

export interface Props {
  title: string;
  description: string;
  path: string;
  readingTime: string;
}
const { title, description, path, readingTime } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  author: { "@type": "Organization", name: "SpeechTeacher" },
  publisher: { "@type": "Organization", name: "SpeechTeacher" },
  mainEntityOfPage: `https://speechteacher.in${path}`,
};
---

<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <article class="container-page max-w-2xl py-16">
    <a href="/resources" class="font-mono text-xs uppercase tracking-wide text-mute hover:text-ink">
      ← Resources
    </a>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
    <p class="mt-3 font-mono text-xs text-mute">{readingTime}</p>
    <div class="rich-text mt-8">
      <slot />
    </div>
  </article>
  <CTASection heading="Reading won't fix it. Reps will." sub="Open the trainer and put this into practice now." />
</Layout>
