---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Practice — SpeechTeacher"
  description="Open the SpeechTeacher trainer: get a prompt, record yourself, and see instant on-device feedback on pace and filler words. Free, private, in your browser."
  path="/practice"
>
  <section class="container-page max-w-3xl py-12">
    <div class="text-center">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Off the cuff</h1>
      <p class="mt-3 text-body">Speak on the spot. Get instant feedback. Nothing leaves your device.</p>
    </div>

    <!-- Prompt -->
    <div class="mt-8 rounded-lg border border-hairline bg-canvas p-6 shadow-soft">
      <p class="font-mono text-xs uppercase tracking-wide text-mute">Today's challenge</p>
      <p id="promptText" class="mt-2 text-xl font-semibold tracking-tight">—</p>
      <button id="newPrompt" class="mt-4 rounded-full border border-hairline bg-canvas px-4 py-2 text-sm font-medium transition-colors hover:border-hairline-strong">↻ New prompt</button>
    </div>

    <!-- Recorder -->
    <div class="mt-6 rounded-lg border border-hairline bg-canvas p-6 text-center shadow-soft">
      <div id="timer" class="text-5xl font-semibold tabular-nums text-mute">0:00</div>
      <div id="status" role="status" aria-live="polite" class="mt-2 min-h-5 text-sm text-mute"><span class="spinner"></span>Warming up the recorder… read the prompt while you wait.</div>
      <div class="mt-4 flex justify-center gap-3">
        <button id="recordBtn" class="rounded-full bg-error px-6 py-3 font-medium text-white transition-opacity hover:opacity-90 disabled:opacity-40" disabled>● Record</button>
        <button id="stopBtn" class="rounded-full bg-warning px-6 py-3 font-medium text-ink transition-opacity hover:opacity-90 disabled:opacity-40" disabled>■ Stop</button>
      </div>
      <audio id="playback" class="mt-4 hidden w-full" controls></audio>
    </div>

    <!-- Results / coaching report -->
    <div id="results" class="dyn mt-6 hidden rounded-lg border border-hairline bg-canvas p-6 shadow-soft">
      <!-- Score header -->
      <div class="flex items-center gap-5">
        <div id="scoreRing" class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full border-4 border-hairline">
          <span id="scoreVal" class="text-2xl font-semibold tabular-nums">—</span>
        </div>
        <div>
          <h2 id="scoreLabel" class="text-lg font-semibold tracking-tight">Your delivery</h2>
          <p id="scoreSummary" class="mt-1 text-sm text-body"></p>
        </div>
      </div>

      <!-- Metric grid -->
      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-md bg-canvas-soft p-4 text-center">
          <div id="mPace" class="text-2xl font-semibold tabular-nums">—</div>
          <div class="mt-0.5 font-mono text-[11px] uppercase tracking-wide text-mute">Words / min</div>
          <div id="mPaceSub" class="sub"></div>
        </div>
        <div class="rounded-md bg-canvas-soft p-4 text-center">
          <div id="mFiller" class="text-2xl font-semibold tabular-nums">—</div>
          <div class="mt-0.5 font-mono text-[11px] uppercase tracking-wide text-mute">Filler words</div>
          <div id="mFillerSub" class="sub"></div>
        </div>
        <div class="rounded-md bg-canvas-soft p-4 text-center">
          <div id="mDuration" class="text-2xl font-semibold tabular-nums">—</div>
          <div class="mt-0.5 font-mono text-[11px] uppercase tracking-wide text-mute">Duration</div>
          <div id="mDurationSub" class="sub"></div>
        </div>
        <div class="rounded-md bg-canvas-soft p-4 text-center">
          <div id="mWords" class="text-2xl font-semibold tabular-nums">—</div>
          <div class="mt-0.5 font-mono text-[11px] uppercase tracking-wide text-mute">Total words</div>
          <div id="mWordsSub" class="sub"></div>
        </div>
        <div class="rounded-md bg-canvas-soft p-4 text-center">
          <div id="mSentence" class="text-2xl font-semibold tabular-nums">—</div>
          <div class="mt-0.5 font-mono text-[11px] uppercase tracking-wide text-mute">Avg words / sentence</div>
          <div id="mSentenceSub" class="sub"></div>
        </div>
        <div class="rounded-md bg-canvas-soft p-4 text-center">
          <div id="mUnique" class="text-2xl font-semibold tabular-nums">—</div>
          <div class="mt-0.5 font-mono text-[11px] uppercase tracking-wide text-mute">Vocabulary variety</div>
          <div id="mUniqueSub" class="sub"></div>
        </div>
        <div class="rounded-md bg-canvas-soft p-4 text-center">
          <div id="mWeak" class="text-2xl font-semibold tabular-nums">—</div>
          <div class="mt-0.5 font-mono text-[11px] uppercase tracking-wide text-mute">Vague / weak words</div>
          <div id="mWeakSub" class="sub"></div>
        </div>
        <div class="rounded-md bg-canvas-soft p-4 text-center">
          <div id="mPauses" class="text-2xl font-semibold tabular-nums">—</div>
          <div class="mt-0.5 font-mono text-[11px] uppercase tracking-wide text-mute">Long pauses</div>
          <div id="mPausesSub" class="sub"></div>
        </div>
      </div>

      <!-- Transcript with highlights -->
      <div class="mt-6">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h3 class="text-sm font-semibold">What you said</h3>
          <div class="flex gap-3 text-xs text-mute">
            <span><span class="lg-filler"></span> filler word</span>
            <span><span class="lg-weak"></span> vague / weak</span>
          </div>
        </div>
        <div id="transcriptBox" class="dyn mt-2 max-h-72 overflow-y-auto rounded-md bg-canvas-soft p-4 text-left leading-relaxed"></div>
      </div>

      <!-- What to improve -->
      <div id="improveBlock" class="mt-6 hidden">
        <h3 class="text-sm font-semibold">What to improve</h3>
        <ul id="improveList" class="dyn mt-3 space-y-2"></ul>
      </div>

      <!-- What you did well -->
      <div id="strengthBlock" class="mt-6 hidden">
        <h3 class="text-sm font-semibold">What you did well</h3>
        <ul id="strengthList" class="dyn mt-3 space-y-2"></ul>
      </div>

      <!-- Filler breakdown -->
      <div id="fillerBreakdown" class="mt-5 flex flex-wrap gap-2"></div>
    </div>

    <!-- Streak -->
    <div class="mt-6 flex items-center justify-between rounded-lg border border-hairline bg-canvas p-6 shadow-soft">
      <div>
        <p class="font-mono text-xs uppercase tracking-wide text-mute">Practice streak</p>
        <p class="mt-0.5 text-xs text-mute">Sessions completed</p>
      </div>
      <div id="streakVal" class="text-2xl font-semibold">0 🔥</div>
    </div>

    <!-- History -->
    <div id="historyCard" class="dyn mt-6 hidden rounded-lg border border-hairline bg-canvas p-6 shadow-soft">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold">Progress</h2>
        <button id="clearHistory" class="text-xs text-mute transition-colors hover:text-error">Clear history</button>
      </div>
      <div class="mt-4 grid grid-cols-2 gap-3">
        <div class="rounded-md bg-canvas-soft p-3">
          <div class="font-mono text-[11px] uppercase tracking-wide text-mute">Pace (WPM)</div>
          <div id="chartWpmNow" class="text-xl font-semibold tabular-nums">—</div>
          <svg id="chartWpm" viewBox="0 0 100 48" preserveAspectRatio="none" class="mt-1.5 block h-12 w-full"></svg>
        </div>
        <div class="rounded-md bg-canvas-soft p-3">
          <div class="font-mono text-[11px] uppercase tracking-wide text-mute">Filler rate (%)</div>
          <div id="chartFillNow" class="text-xl font-semibold tabular-nums">—</div>
          <svg id="chartFill" viewBox="0 0 100 48" preserveAspectRatio="none" class="mt-1.5 block h-12 w-full"></svg>
        </div>
      </div>
      <div id="histList" class="mt-4 flex flex-col gap-2"></div>
    </div>

    <p class="mt-6 text-center text-xs text-mute">
      Speech is transcribed locally on your device with Whisper. Nothing is uploaded.
    </p>
  </section>
</Layout>

<!-- Styles for JS-injected (uncontrolled) markup only -->
<style>
  .spinner { display:inline-block; width:12px; height:12px; border:2px solid #888; border-top-color:#0070f3; border-radius:50%; animation: spin .7s linear infinite; margin-right:6px; vertical-align:-1px; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .dot { display:inline-block; width:9px; height:9px; border-radius:50%; background:#ee0000; margin-right:6px; }
  .dot.pulse { animation: pulse 1s infinite; }
  @keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:.3;} }
  .dyn .filler { color:#ee0000; font-weight:700; text-decoration:underline; }
  .dyn .weak { color:#ab570a; text-decoration:underline; text-decoration-style:dotted; }
  .dyn #transcriptBox:empty::before { content:"Your transcript will appear here after you stop…"; color:#888; }
  .lg-filler, .lg-weak { display:inline-block; width:10px; height:10px; border-radius:2px; vertical-align:middle; margin-right:3px; }
  .lg-filler { background:#ee0000; } .lg-weak { background:#f5a623; }
  .sub { font-size:11px; margin-top:4px; }
  .v-good { color:#0070f3; } .v-warn { color:#ab570a; } .v-bad { color:#ee0000; }
  .chip { background:#fafafa; border:1px solid #ebebeb; border-radius:9999px; padding:5px 12px; font-size:13px; }
  .chip b { color:#ee0000; }
  .tip { display:flex; gap:10px; align-items:flex-start; background:#fafafa; border:1px solid #ebebeb; border-radius:8px; padding:10px 12px; font-size:14px; line-height:1.5; }
  .tip .ic { flex-shrink:0; font-weight:700; line-height:1.5; }
  .tip.improve .ic { color:#ab570a; } .tip.good .ic { color:#0070f3; }
  .tip b { color:#171717; }
  .hist-row { display:grid; grid-template-columns:auto 1fr auto; gap:10px; align-items:center; background:#fafafa; border-radius:8px; padding:10px 12px; font-size:13px; }
  .hist-row .when { color:#888; font-variant-numeric:tabular-nums; white-space:nowrap; }
  .hist-row .what { color:#171717; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .hist-row .scores { display:flex; gap:10px; white-space:nowrap; }
  .hist-row .scores span { color:#888; }
  .hist-row .scores b { color:#171717; font-variant-numeric:tabular-nums; }
</style>

<script type="module" is:inline>
import { pipeline, env } from "https://cdn.jsdelivr.net/npm/@xenova/transformers@2.17.2";
env.allowLocalModels = false;

const PROMPTS = [
  "Describe a skill you wish you had, and why.",
  "Convince me to visit your hometown.",
  "What would you do with an extra hour every day?",
  "Explain your favorite hobby to someone who's never heard of it.",
  "Tell a story about a time you were proud of yourself.",
  "If you could have dinner with anyone, who and why?",
  "Pitch a product that solves a problem you face daily.",
  "What's a belief you've changed your mind about?",
  "Describe the best meal you've ever eaten.",
  "Argue for or against working from home.",
  "What advice would you give your younger self?",
  "Explain how something works — anything you know well.",
  "Describe your perfect weekend, minute by minute.",
  "What's a small thing that makes a big difference?",
  "Sell me on a book, movie, or song you love."
];

const FILLERS = ["um","uh","umm","uhh","like","you know","so","actually","basically","literally","kind of","sort of","i mean","right","okay","well"];
const MULTI_FILLERS = FILLERS.filter(f => f.includes(" "));
const SINGLE_FILLERS = new Set(FILLERS.filter(f => !f.includes(" ")));

// Vague / hedging words (distinct from fillers) — weaken a message
const WEAK = new Set(["just","really","very","maybe","probably","perhaps","stuff","things","pretty","honestly","obviously","somewhat","quite","guess","kinda","sorta"]);

let mediaRecorder = null, chunks = [], stream = null;
let startTime = 0, durationMs = 0, timerInterval = null, recording = false;
let transcriber = null;

const el = id => document.getElementById(id);
const promptText = el("promptText"), timerEl = el("timer"), statusEl = el("status");
const transcriptBox = el("transcriptBox"), recordBtn = el("recordBtn"), stopBtn = el("stopBtn");
const playback = el("playback"), results = el("results"), streakVal = el("streakVal");
const historyCard = el("historyCard"), histList = el("histList");

function pickPrompt() { promptText.textContent = PROMPTS[Math.floor(Math.random() * PROMPTS.length)]; }
el("newPrompt").addEventListener("click", pickPrompt);
pickPrompt();

function loadStreak() {
  const n = parseInt(localStorage.getItem("otc_streak") || "0", 10);
  streakVal.textContent = n + " 🔥"; return n;
}
function bumpStreak() {
  const n = loadStreak() + 1;
  localStorage.setItem("otc_streak", String(n));
  streakVal.textContent = n + " 🔥";
}
loadStreak();

const HISTORY_KEY = "otc_history";
function loadHistory() { try { return JSON.parse(localStorage.getItem(HISTORY_KEY) || "[]"); } catch (e) { return []; } }
function saveSession(prompt, a) {
  const hist = loadHistory();
  hist.push({ t: new Date().toISOString(), prompt, wpm: a.wpm, fillerRate: Math.round(a.fillerRate*10)/10, totalWords: a.totalWords, totalFillers: a.totalFillers });
  localStorage.setItem(HISTORY_KEY, JSON.stringify(hist.slice(-100)));
}

function sparkline(svg, values, color, opts = {}) {
  svg.innerHTML = "";
  if (!values.length) return;
  const W = 100, H = 48, pad = 4;
  const max = opts.max != null ? opts.max : Math.max(...values, 1);
  const min = opts.min != null ? opts.min : Math.min(...values, 0);
  const range = (max - min) || 1, n = values.length;
  const x = i => n === 1 ? W/2 : pad + (i/(n-1))*(W-2*pad);
  const y = v => H - pad - ((v-min)/range)*(H-2*pad);
  const NS = "http://www.w3.org/2000/svg";
  if (opts.band) {
    const rect = document.createElementNS(NS,"rect");
    rect.setAttribute("x",0); rect.setAttribute("width",W);
    rect.setAttribute("y",y(opts.band[1])); rect.setAttribute("height",Math.max(0,y(opts.band[0])-y(opts.band[1])));
    rect.setAttribute("fill","#0070f3"); rect.setAttribute("opacity","0.10"); svg.appendChild(rect);
  }
  const line = document.createElementNS(NS,"polyline");
  line.setAttribute("fill","none"); line.setAttribute("stroke",color); line.setAttribute("stroke-width","2");
  line.setAttribute("stroke-linejoin","round"); line.setAttribute("stroke-linecap","round");
  line.setAttribute("points", values.map((v,i)=>x(i)+","+y(v)).join(" ")); svg.appendChild(line);
  const dot = document.createElementNS(NS,"circle");
  dot.setAttribute("cx",x(n-1)); dot.setAttribute("cy",y(values[n-1])); dot.setAttribute("r","2.5"); dot.setAttribute("fill",color);
  svg.appendChild(dot);
}

function fmtWhen(iso) {
  const d = new Date(iso), now = new Date();
  const sameDay = d.toDateString() === now.toDateString();
  return sameDay ? d.toLocaleTimeString([], {hour:"numeric",minute:"2-digit"}) : d.toLocaleDateString([], {month:"short",day:"numeric"});
}

function renderHistory() {
  const hist = loadHistory();
  if (!hist.length) { historyCard.classList.add("hidden"); return; }
  historyCard.classList.remove("hidden");
  const last = hist[hist.length-1];
  el("chartWpmNow").textContent = last.wpm;
  el("chartFillNow").textContent = last.fillerRate + "%";
  sparkline(el("chartWpm"), hist.map(h=>h.wpm), "#0070f3", { band:[110,160] });
  sparkline(el("chartFill"), hist.map(h=>h.fillerRate), "#f5a623", { min:0 });
  histList.innerHTML = hist.slice().reverse().slice(0,8).map(h =>
    '<div class="hist-row"><span class="when">' + fmtWhen(h.t) + '</span>' +
    '<span class="what">' + h.prompt.replace(/[<>&]/g,"") + '</span>' +
    '<span class="scores"><span><b>' + h.wpm + '</b> wpm</span><span><b>' + h.totalFillers + '</b> filler</span></span></div>'
  ).join("");
}
el("clearHistory").addEventListener("click", () => {
  if (confirm("Clear all saved sessions? This can't be undone.")) { localStorage.removeItem(HISTORY_KEY); renderHistory(); }
});
renderHistory();

function fmt(ms) { const s = Math.floor(ms/1000); return Math.floor(s/60)+":"+String(s%60).padStart(2,"0"); }
function tick() { timerEl.textContent = fmt(Date.now()-startTime); }

function renderTranscript(text) {
  const safe = s => s.replace(/[&<>]/g, c => ({ "&":"&amp;","<":"&lt;",">":"&gt;" }[c]));
  const words = text.trim().split(/\s+/).filter(Boolean);
  transcriptBox.innerHTML = words.map(w => {
    const clean = w.toLowerCase().replace(/[^a-z']/g,"");
    if (SINGLE_FILLERS.has(clean)) return '<span class="filler">'+safe(w)+"</span>";
    if (WEAK.has(clean)) return '<span class="weak">'+safe(w)+"</span>";
    return safe(w);
  }).join(" ");
}

function analyze(transcript, ms, pauses) {
  const text = " " + transcript.toLowerCase().replace(/[^a-z' ]/g," ").replace(/\s+/g," ") + " ";
  const words = transcript.trim().split(/\s+/).filter(Boolean);
  const totalWords = words.length, durationSec = Math.round(ms/1000), minutes = ms/60000;

  // Fillers (multi-word first, then single)
  const counts = {}; let totalFillers = 0, working = text;
  MULTI_FILLERS.forEach(f => {
    const re = new RegExp("\\s"+f.replace(/ /g,"\\s")+"\\s","g");
    const m = working.match(re);
    if (m) { counts[f]=m.length; totalFillers+=m.length; working=working.replace(re,"  "); }
  });
  const cleanWords = working.trim().split(/\s+/).filter(Boolean);
  cleanWords.forEach(w => { if (SINGLE_FILLERS.has(w)) { counts[w]=(counts[w]||0)+1; totalFillers++; } });

  // Weak / vague words
  let weakCount = 0; const weakCounts = {};
  cleanWords.forEach(w => { if (WEAK.has(w)) { weakCount++; weakCounts[w]=(weakCounts[w]||0)+1; } });
  const topWeak = Object.entries(weakCounts).sort((a,b)=>b[1]-a[1])[0];

  // Sentences (Whisper emits punctuation)
  const sentences = transcript.split(/[.!?]+/).map(s=>s.trim()).filter(s=>s.split(/\s+/).filter(Boolean).length>0);
  const sentenceCount = sentences.length || 1;
  const avgSentence = Math.round(totalWords / sentenceCount);
  const longestSentence = sentences.reduce((m,s)=>Math.max(m,s.split(/\s+/).filter(Boolean).length),0);

  // Vocabulary variety (unique non-filler words / total)
  const uniq = new Set(words.map(w=>w.toLowerCase().replace(/[^a-z']/g,"")).filter(Boolean));
  const diversity = totalWords > 0 ? Math.round((uniq.size/totalWords)*100) : 0;

  // Repeated consecutive words ("the the")
  let repeats = 0;
  for (let i=1;i<cleanWords.length;i++) if (cleanWords[i] && cleanWords[i]===cleanWords[i-1]) repeats++;

  const wpm = minutes > 0 ? Math.round(totalWords/minutes) : 0;
  const fillerRate = totalWords > 0 ? (totalFillers/totalWords)*100 : 0;
  const topFiller = Object.entries(counts).sort((a,b)=>b[1]-a[1])[0];

  const pauseList = pauses || [];
  const longestPause = pauseList.reduce((m,p)=>Math.max(m,p),0);

  // Composite score
  let score = 100;
  score -= Math.min(28, fillerRate*3);
  if (wpm > 0 && wpm < 110) score -= Math.min(20, (110-wpm)/3);
  if (wpm > 160) score -= Math.min(20, (wpm-160)/3);
  score -= Math.min(15, (weakCount/Math.max(totalWords,1))*100*1.5);
  if (avgSentence > 25) score -= Math.min(15, (avgSentence-25)/2);
  score -= Math.min(10, repeats*3);
  if (longestPause > 3) score -= Math.min(10, (longestPause-3)*2);
  if (durationSec < 20) score -= 12;
  score = Math.max(0, Math.min(100, Math.round(score)));

  return {
    totalWords, durationSec, wpm, totalFillers, fillerRate, counts, topFiller,
    weakCount, topWeak, sentenceCount, avgSentence, longestSentence,
    diversity, repeats, pauseCount: pauseList.length, longestPause, score
  };
}

function setMetric(id, val, subText, subClass) {
  el(id).textContent = val;
  const sub = el(id+"Sub");
  if (sub) { sub.textContent = subText || ""; sub.className = "sub" + (subClass ? " "+subClass : ""); }
}
function fmtDur(sec) { return sec >= 60 ? Math.floor(sec/60)+"m "+(sec%60)+"s" : sec+"s"; }

function showResults(a) {
  results.classList.remove("hidden");

  // Score ring
  el("scoreVal").textContent = a.score;
  const ring = el("scoreRing");
  let band, color;
  if (a.score >= 85) { band = "Excellent delivery"; color = "#0070f3"; }
  else if (a.score >= 70) { band = "Good — a few tweaks"; color = "#29bc9b"; }
  else if (a.score >= 50) { band = "Fair — clear room to grow"; color = "#f5a623"; }
  else { band = "Needs work — keep at it"; color = "#ee0000"; }
  ring.style.borderColor = color;
  el("scoreVal").style.color = color;
  el("scoreLabel").textContent = band;
  el("scoreSummary").textContent =
    `You spoke ${a.totalWords} words in ${fmtDur(a.durationSec)} at ${a.wpm} WPM, with ${a.totalFillers} filler word${a.totalFillers===1?"":"s"}.`;

  // Pace
  if (a.wpm === 0) setMetric("mPace", "—", "", "");
  else if (a.wpm < 110) setMetric("mPace", a.wpm, "A bit slow", "v-warn");
  else if (a.wpm <= 160) setMetric("mPace", a.wpm, "Great pace ✓", "v-good");
  else setMetric("mPace", a.wpm, "Too fast", "v-bad");

  // Fillers
  if (a.fillerRate <= 2) setMetric("mFiller", a.totalFillers, "Clean ✓", "v-good");
  else if (a.fillerRate <= 5) setMetric("mFiller", a.totalFillers, a.fillerRate.toFixed(1)+"% of words", "v-warn");
  else setMetric("mFiller", a.totalFillers, a.fillerRate.toFixed(1)+"% — trim", "v-bad");

  // Duration
  setMetric("mDuration", fmtDur(a.durationSec),
    a.durationSec < 20 ? "Too short" : a.durationSec > 120 ? "Long" : "Good length",
    a.durationSec < 20 ? "v-warn" : "v-good");

  // Words
  setMetric("mWords", a.totalWords, a.sentenceCount + " sentence" + (a.sentenceCount===1?"":"s"), "");

  // Avg sentence length
  setMetric("mSentence", a.avgSentence,
    a.avgSentence > 25 ? "Long sentences" : "Easy to follow",
    a.avgSentence > 25 ? "v-warn" : "v-good");

  // Vocabulary variety
  setMetric("mUnique", a.diversity + "%",
    a.diversity >= 55 ? "Varied" : "Repetitive",
    a.diversity >= 55 ? "v-good" : "v-warn");

  // Weak words
  setMetric("mWeak", a.weakCount,
    a.weakCount <= 1 ? "Confident ✓" : a.topWeak ? "e.g. \""+a.topWeak[0]+"\"" : "",
    a.weakCount <= 1 ? "v-good" : "v-warn");

  // Pauses
  setMetric("mPauses", a.pauseCount,
    a.longestPause ? "longest "+a.longestPause.toFixed(1)+"s" : "smooth",
    a.longestPause > 3 ? "v-warn" : "v-good");

  // ── Generate coaching tips ──
  const improve = [], strong = [];

  if (a.totalFillers > 0) {
    const top = a.topFiller ? ` Your most common was <b>"${a.topFiller[0]}"</b> (${a.topFiller[1]}×).` : "";
    if (a.fillerRate > 5)
      improve.push(`<b>Cut filler words.</b> ${a.totalFillers} fillers is ${a.fillerRate.toFixed(1)}% of your speech.${top} Replace them with a short silent pause — silence reads as confidence.`);
    else
      improve.push(`<b>Trim a few fillers.</b> You used ${a.totalFillers}.${top} When you feel one coming, just pause instead.`);
  }
  if (a.wpm > 160)
    improve.push(`<b>Slow down.</b> At ${a.wpm} WPM you're racing. Aim for 110–160 — pause between ideas so each point lands.`);
  if (a.wpm > 0 && a.wpm < 110 && a.durationSec >= 15)
    improve.push(`<b>Pick up the pace.</b> ${a.wpm} WPM is on the slow side. Add energy and close the gaps between thoughts.`);
  if (a.weakCount >= 3)
    improve.push(`<b>Sound more certain.</b> You used ${a.weakCount} vague/hedging words${a.topWeak?` (like "${a.topWeak[0]}")`:""}. Swap them for concrete, direct phrasing.`);
  if (a.avgSentence > 25)
    improve.push(`<b>Shorten your sentences.</b> They average ${a.avgSentence} words${a.longestSentence?` (longest ${a.longestSentence})`:""}. Make a point, stop, then the next one.`);
  if (a.repeats > 0)
    improve.push(`<b>Watch repeated words.</b> You stumbled on a back-to-back repeat ${a.repeats} time${a.repeats===1?"":"s"}. A slight slow-down prevents it.`);
  if (a.longestPause > 3)
    improve.push(`<b>Mind the long gaps.</b> Your longest pause was ${a.longestPause.toFixed(1)}s — short pauses are great, but very long ones read as losing your place.`);
  if (a.durationSec < 20)
    improve.push(`<b>Speak longer.</b> You went for ${fmtDur(a.durationSec)}. Aim for 30–90s to give yourself a real rep.`);
  if (a.diversity < 45 && a.totalWords > 30)
    improve.push(`<b>Vary your words.</b> Only ${a.diversity}% of your words were unique — you leaned on a few. Reach for synonyms and concrete detail.`);
  if (a.sentenceCount < 2 && a.totalWords > 40)
    improve.push(`<b>Add structure.</b> It ran as one long thought. Try: state your point, give one example, then close.`);

  if (a.fillerRate <= 2) strong.push(`<b>Clean delivery</b> — almost no filler words.`);
  if (a.wpm >= 110 && a.wpm <= 160) strong.push(`<b>Great conversational pace</b> at ${a.wpm} WPM.`);
  if (a.weakCount <= 1) strong.push(`<b>Confident, direct language</b> — little hedging.`);
  if (a.avgSentence <= 20 && a.sentenceCount >= 2) strong.push(`<b>Well-sized sentences</b> that are easy to follow.`);
  if (a.diversity >= 60) strong.push(`<b>Varied vocabulary</b> — you didn't repeat yourself much.`);
  if (a.durationSec >= 30 && a.durationSec <= 120) strong.push(`<b>Good length</b> — enough to actually evaluate.`);
  if (a.longestPause && a.longestPause <= 2 && a.pauseCount > 0) strong.push(`<b>Tight pacing</b> — no awkward dead air.`);

  if (!improve.length) improve.push(`<b>Nothing major to fix.</b> Keep doing reps to lock this in.`);

  renderTips("improveList", "improveBlock", improve, "improve", "→");
  renderTips("strengthList", "strengthBlock", strong, "good", "✓");

  // Filler breakdown chips
  const bd = el("fillerBreakdown");
  const entries = Object.entries(a.counts).sort((x,y)=>y[1]-x[1]);
  bd.innerHTML = entries.length
    ? entries.map(([w,c]) => '<span class="chip">'+w+' <b>'+c+"</b></span>").join("")
    : '<span class="chip" style="color:#0070f3">No filler words — nice! ✓</span>';
}

function renderTips(listId, blockId, items, cls, icon) {
  const block = el(blockId);
  if (!items.length) { block.classList.add("hidden"); return; }
  block.classList.remove("hidden");
  el(listId).innerHTML = items.map(t =>
    '<li class="tip '+cls+'"><span class="ic">'+icon+'</span><span>'+t+'</span></li>'
  ).join("");
}

async function loadModel() {
  try {
    transcriber = await pipeline("automatic-speech-recognition", "Xenova/whisper-tiny.en");
    statusEl.textContent = "Tap record, then speak about the prompt.";
    recordBtn.disabled = false;
  } catch (e) {
    statusEl.textContent = "⚠️ Couldn't start the recorder. Check your connection and refresh.";
  }
}

async function blobTo16kMono(blob) {
  const arrayBuffer = await blob.arrayBuffer();
  const ac = new (window.AudioContext || window.webkitAudioContext)();
  const decoded = await ac.decodeAudioData(arrayBuffer);
  ac.close();

  // Downmix all channels to mono using the real sample count
  // (MediaRecorder WebM duration metadata is unreliable, so never derive length from .duration)
  const channels = decoded.numberOfChannels;
  const len = decoded.length;
  const mono = new Float32Array(len);
  for (let c = 0; c < channels; c++) {
    const data = decoded.getChannelData(c);
    for (let i = 0; i < len; i++) mono[i] += data[i] / channels;
  }

  // Resample to 16 kHz with linear interpolation
  const srcRate = decoded.sampleRate;
  if (srcRate === 16000) return mono;
  const ratio = srcRate / 16000;
  const outLen = Math.floor(len / ratio);
  const out = new Float32Array(outLen);
  for (let i = 0; i < outLen; i++) {
    const pos = i * ratio;
    const i0 = Math.floor(pos);
    const i1 = Math.min(i0 + 1, len - 1);
    const frac = pos - i0;
    out[i] = mono[i0] * (1 - frac) + mono[i1] * frac;
  }
  return out;
}

// Loudness of the captured audio — used to detect a dead/silent mic
function audioPeak(audio) {
  let peak = 0;
  for (let i = 0; i < audio.length; i++) { const v = Math.abs(audio[i]); if (v > peak) peak = v; }
  return peak;
}

// Strip Whisper's non-speech annotations: [BLANK_AUDIO], [Music], (applause), *laughs*…
function cleanTranscript(raw) {
  return (raw || "")
    .replace(/\[[^\]]*\]/g, " ")
    .replace(/\([^)]*\)/g, " ")
    .replace(/\*[^*]*\*/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

async function startRecording() {
  try {
    stream = await navigator.mediaDevices.getUserMedia({
      audio: { channelCount: 1, echoCancellation: true, noiseSuppression: true, autoGainControl: true }
    });
  }
  catch (e) { statusEl.textContent = "🎤 Microphone access denied. Allow it and try again."; return; }
  chunks = []; transcriptBox.innerHTML = ""; results.classList.add("hidden"); playback.classList.add("hidden");
  mediaRecorder = new MediaRecorder(stream);
  mediaRecorder.ondataavailable = e => { if (e.data.size > 0) chunks.push(e.data); };
  mediaRecorder.onstop = onStopped;
  mediaRecorder.start();
  recording = true; startTime = Date.now();
  timerEl.classList.remove("text-mute");
  timerInterval = setInterval(tick, 200); tick();
  recordBtn.disabled = true; stopBtn.disabled = false;
  statusEl.innerHTML = '<span class="dot pulse"></span> Recording — speak now.';
}

function stopRecording() {
  if (!recording) return;
  recording = false; durationMs = Date.now() - startTime;
  clearInterval(timerInterval);
  if (mediaRecorder && mediaRecorder.state !== "inactive") mediaRecorder.stop();
  stopBtn.disabled = true;
}

async function onStopped() {
  const blob = new Blob(chunks, { type: mediaRecorder.mimeType || "audio/webm" });
  playback.src = URL.createObjectURL(blob); playback.classList.remove("hidden");
  if (stream) stream.getTracks().forEach(t => t.stop());
  statusEl.innerHTML = '<span class="spinner"></span> Transcribing on your device…';
  try {
    const audio = await blobTo16kMono(blob);

    // Mic check: if the captured audio is near-silent, it's a hardware/permission issue, not the model
    const peak = audioPeak(audio);
    const levelPct = Math.round(peak * 100);
    if (peak < 0.01) {
      statusEl.innerHTML = "🔇 Mic level was only " + levelPct + "% — almost no sound reached the page. Play the recording below: if you can't hear yourself, the wrong input is selected or its volume is near zero. Click the mic icon in Opera's address bar to pick the right device, raise the input level in Windows Sound settings, and try again.";
      recordBtn.disabled = false; return;
    }

    const out = await transcriber(audio, { chunk_length_s: 30, stride_length_s: 5, return_timestamps: true });
    const transcript = cleanTranscript(out.text);
    if (!transcript) { statusEl.innerHTML = "⚠️ Audio came through but no clear speech was detected. Try speaking a bit louder and closer to the mic, in a quieter spot."; recordBtn.disabled = false; return; }

    // Detect long pauses from segment timestamps
    const pauses = [];
    if (Array.isArray(out.chunks)) {
      for (let i = 1; i < out.chunks.length; i++) {
        const prevEnd = out.chunks[i-1].timestamp && out.chunks[i-1].timestamp[1];
        const curStart = out.chunks[i].timestamp && out.chunks[i].timestamp[0];
        if (typeof prevEnd === "number" && typeof curStart === "number") {
          const gap = curStart - prevEnd;
          if (gap >= 1.0) pauses.push(gap);
        }
      }
    }

    renderTranscript(transcript);
    const a = analyze(transcript, durationMs, pauses);
    showResults(a); bumpStreak(); saveSession(promptText.textContent, a); renderHistory();
    statusEl.textContent = "Done! Review your delivery below.";
  } catch (e) {
    statusEl.textContent = "⚠️ Transcription failed: " + (e.message || e);
  }
  recordBtn.disabled = false;
}

recordBtn.addEventListener("click", startRecording);
stopBtn.addEventListener("click", stopRecording);
loadModel();
</script>
